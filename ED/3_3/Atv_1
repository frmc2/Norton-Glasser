#include <stdio.h>
#include <string.h>

typedef struct {
    char nome[50];
    int cpf;
    float saldo;
    int id;
} Registros;
Registros *contas = NULL;   
int contar=0;


void saldo(int i, float j, float x){
    printf("\n\n\n>>>>>>>>>>Saldo<<<<<<<<<<\n\n\n");
    printf("Cliente: %s\n", contas[i].nome);
    printf("id:      %i\n", contas[i].id);
    printf("Saldo anterior: %.2f\n", x);
    if(j>=0) printf("               +%.2f\n", j);
    else printf("               %.2f\n", j);
    printf("Saldo atual:    %.2f\n", contas[i].saldo);
    printf("\n\n\n>>>>>>>>>>Saldo<<<<<<<<<<\n\n\n");
}

void inicializar(char nome[50]){
    int cpf;

    printf("Digite somente os números de seu CPF");
    scanf("%i", &cpf);
    
    contas = realloc(contas, (contar + 1) * sizeof(Registros));
    
    contar = i;
    strcpy(contas[contar].nome, nome);
    contas[contar].cpf = cpf;
    contas[contar].saldo = 0;
    contas[contar].id = contar+1;
    
    contar++;
}

int validaçaoid(char nome[]){
    int i=0;
    for (int i = 0; i < contar; i++) {
        if (strcmp(contas[i].nome, nome) == 0) {
            return i;
        }
    }
    return -1;
}

void depositar(int i){
    float money=0, x=contas[i].saldo;
    
    printf("Selecione valor a depositar: ");
    scanf("%f", &money);
    
    contas[i].saldo += money;
    printf("Deposito concluido.\n");
    saldo(i, money, x);
}

void sacar(int i){
    float money=0, x=contas[i].saldo;
    
    printf("Selecione valor a sacar: ");
    scanf("%f", &money);
    
    if(money <= contas[i].saldo){
        contas[i].saldo -= money;
    printf("Saque concluido.\n");
    } else{
        printf("Valor insuficiente.\n Cancelando transação.\n");
        money = 0;
    }
    saldo(i, money, x);
}

int main(){
    enum ação {inicializar = 1, deposito, sacar, sair};
    enum ação acao=0;
    char Cliente[50];
    int i;
    
    printf("Nome completo:\n");
    fgets(Cliente, 50, stdin);
    Cliente[strcspn(Cliente, "\n")] = '\0';
    i = validaçaoid(Cliente);
    
    while(acao != sair){
        printf("\nO que gostaria de fazer?\n1 - Criar uma nova conta\n2-Depositar\n3-Sacar\n4-Sair\n");
        scanf("%i", &acao);
        switch(acao){
            case(inicializar):
                if(i != -1){
                    printf("Conta já existente, cancelando cadastro.\nTerminando sessão");
                } else{
                    inicializar(Cliente);
                    i = contar - 1;
                    printf("Cadastro realizado.\nTerminando sessão\n");
                }
                break;
            case deposito:
                printf("Nome:\n");
                depositar(i);
                printf("\nTerminando sessão.\n");
                break;
            case sacar:
                sacar(i);
                printf("\nTerminando sessão.\n");
                break;
            case sair:
                printf("Encerrando programa.\n");
                break;
            default:
                printf("Comando não reconhecido.\n");
                break;
        }
    }
    free(contas);
}
