#include <stdio.h>

int fubinaacci2(int x){
    if(x==0) return 0;
    if(x==1) return 1;
    return fubinaacci2(x-1)+fubinaacci2(x-2);
}

int fubinaacci(int x,int y){
    printf("%i ", fubinaacci2(x));
    if(x != y) return fubinaacci(x+1,y);
}

int main()
{
    int x=0, y;

    printf("fubinaacci:\n");
    scanf("%i", &y);
    fubinaacci(x, y);

    return 0;
}
